# Database
DATABASE_URL=postgresql://saap:saap_pass@postgres:5432/saap_db
POSTGRES_USER=saap
POSTGRES_PASSWORD=saap_pass
POSTGRES_DB=saap_db

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_256BIT_HEX
# Separate encryption key for stored Google tokens (optional — falls back to SECRET_KEY)
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_SECURE_RANDOM_KEY

# Google OAuth2
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URI: http://localhost:8000/auth/callback
# 4. Enable: Google Classroom API, Google Drive API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Frontend URL (used by backend to redirect after OAuth)
FRONTEND_URL=http://localhost:3000

# JWT expiry in minutes (default 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Refinement (optional, minimal usage)
OPENAI_API_KEY=your-openai-key-optional

# Google Classroom
GOOGLE_CLASSROOM_SCOPES=https://www.googleapis.com/auth/classroom.courses.readonly,https://www.googleapis.com/auth/classroom.coursework.students

# Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Error Monitoring (optional — get DSN from sentry.io)
SENTRY_DSN=
APP_VERSION=2.0.0
SENTRY_TRACES_RATE=0.1

# Email (SMTP — use Gmail App Password or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@saap.edu

# SMS (Twilio — optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Service URLs (override for production deployments)
# SYLLABUS_SERVICE_URL=http://syllabus-service:8001
# KNOWLEDGE_SERVICE_URL=http://knowledge-service:8002
# QUESTION_SERVICE_URL=http://question-service:8003
# EVALUATION_SERVICE_URL=http://evaluation-service:8004
# ANALYTICS_SERVICE_URL=http://analytics-service:8005
# MANAGEMENT_SERVICE_URL=http://management-service:8006
# EXPORT_SERVICE_URL=http://export-service:8007
# FEATURES_SERVICE_URL=http://features-service:8008
# STUDENT_SERVICE_URL=http://student-service:8009
# NOTIFICATION_SERVICE_URL=http://notification-service:8010
# ADVANCED_SERVICE_URL=http://advanced-service:8011
