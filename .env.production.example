# ============================================================
# SAAP — Production Environment Variables
# Copy to .env and fill in all values before deploying.
# NEVER commit the actual .env file to version control.
# ============================================================

# ── Database ──────────────────────────────────────────────────
# Use a managed PostgreSQL service (Supabase, RDS, Neon, etc.)
DATABASE_URL=postgresql://saap_user:STRONG_PASSWORD@your-db-host:5432/saap_prod
POSTGRES_USER=saap_user
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_DB=saap_prod

# ── Redis ─────────────────────────────────────────────────────
# Use a managed Redis service (Upstash, ElastiCache, etc.)
REDIS_URL=redis://:REDIS_PASSWORD@your-redis-host:6379/0
CELERY_BROKER_URL=redis://:REDIS_PASSWORD@your-redis-host:6379/1
CELERY_RESULT_BACKEND=redis://:REDIS_PASSWORD@your-redis-host:6379/2

# ── Auth ──────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_64_CHAR_HEX_STRING

# Google OAuth — production credentials
GOOGLE_CLIENT_ID=your-prod-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-prod-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/callback

# ── URLs ──────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com

# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=WARNING
APP_VERSION=2.0.0

# ── JWT ───────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Storage ───────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# ── AI (optional) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ── Error monitoring ──────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_RATE=0.1

# ── Email ─────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com

# ── SMS (optional) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# ── Google Classroom ──────────────────────────────────────────
GOOGLE_CLASSROOM_SCOPES=https://www.googleapis.com/auth/classroom.courses.readonly,https://www.googleapis.com/auth/classroom.coursework.students
