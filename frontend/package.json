{
  "name": "saap-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "next": "14.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@tanstack/react-query": "5.37.1",
    "axios": "1.7.2",
    "recharts": "2.12.7",
    "react-hook-form": "7.51.5",
    "zod": "3.23.8",
    "@hookform/resolvers": "3.4.2",
    "lucide-react": "0.379.0",
    "clsx": "2.1.1",
    "tailwind-merge": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/jest": "29.5.12",
    "typescript": "5.4.5",
    "tailwindcss": "3.4.3",
    "postcss": "8.4.38",
    "autoprefixer": "10.4.19",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-jest": "29.1.4",
    "@testing-library/react": "15.0.7",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/user-event": "14.5.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterFramework": [],
    "testMatch": [
      "**/__tests__/**/*.{ts,tsx}",
      "**/*.test.{ts,tsx}",
      "**/tests/frontend/**/*.test.{ts,tsx}"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": ["ts-jest", {
        "tsconfig": {
          "jsx": "react-jsx"
        }
      }]
    },
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json"],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/app/**/*.tsx"
    ]
  }
}
